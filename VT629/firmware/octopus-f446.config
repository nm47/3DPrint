# BTT Octopus-class STM32F446 mainboard ("mcu"), Trident VT629.
# Runs a Katapult bootloader: Application Start = 0x8008000 (32KiB).
# Build:  cp this to ~/klipper/.config && make olddefconfig && make
# Flash:  python3 ~/klipper/lib/katapult/flashtool.py \
#           -d /dev/serial/by-id/usb-Klipper_stm32f446xx_33002E000450534E4E313020-if00 \
#           -f ~/klipper/out/klipper.bin
# Then run FIRMWARE_RESTART. Never DFU-flash this board: it erases Katapult.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F446=y
CONFIG_STM32_FLASH_START_8000=y
CONFIG_STM32_CLOCK_REF_12M=y
CONFIG_STM32_USB_PA11_PA12=y
