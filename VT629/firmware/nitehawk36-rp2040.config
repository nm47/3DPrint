# LDO Nitehawk-36 RP2040 toolboard ("nhk"), Trident VT629.
# Runs a Katapult bootloader: Application Start = 0x10004000 (16KiB).
# Build:  cp this to ~/klipper/.config && make olddefconfig && make
# Flash:  python3 ~/klipper/lib/katapult/flashtool.py \
#           -d /dev/serial/by-id/usb-Klipper_rp2040_303339383409A9B1-if00 \
#           -f ~/klipper/out/klipper.bin
# Then run FIRMWARE_RESTART. The 16KiB offset is required; without it the
# flash overwrites Katapult and recovery needs the physical BOOT0+RESET buttons.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_RPXXXX=y
CONFIG_MACH_RP2040=y
CONFIG_RPXXXX_FLASH_START_4000=y
CONFIG_RPXXXX_USB=y
